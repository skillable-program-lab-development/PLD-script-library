  <Code><![CDATA[# Global Variables
$script:dir = ""
$script:proc = $null
$btnFindText.DialogResult = [System.Windows.Forms.DialogResult]::None

function Validate-Form {
	$retVal = @{
		State = $true
		Msg   = "Success"
	}
	
	# Validate the ID List
	if ($txtIDList.Text -match '^\d+(,\d+)*$') {
		$numbers = $txtIDList.Text -split ',' | ForEach-Object {
			[int]$_
		}
	} else {
#		throw "Invalid input format"
		$retVal.State = $false
		$retVal.Msg = "The ID List must contain an integer or a comma separated list of integers without spaces"
	}
	
	# The Check ID is optional so skip checking it here
	
	# Validate the Search Term list
	if ($retVal.State) {
		$lstTerms = $txtFindText.Text.Split(",")
		if ($lstTerms.Count -eq 0) {
			$retVal.State = $false
			$retVal.Msg = "The Search Terms list must contain an one or more comma separated alpha-numeric terms without spaces"
		}
	}
	
	# At least one of the "Check" boxes must be checked
	if (-not ($chkACPs.Checked -or $chkActivities.Checked -or $chkInstructs.Checked -or $chkLCAs.Checked)) {
		$retVal.State = $false
		$retVal.Msg = "At least one of the 'CHECK' check boxes must be selected"
	}
	
	return $retVal
}

function Add-UiText {
	param ([string]$Text)
	
	if ([string]::IsNullOrEmpty($Text)) {
		return
	}
	
	if ([string]::IsNullOrWhiteSpace($Text)) {
		return
	}
	
	# Marshal to UI thread safely
	if ($txtOutput.InvokeRequired) {
		$null = $txtOutput.BeginInvoke([Action[string]]{
				param ($t)
				$txtOutput.AppendText($t + "`r`n")
				$txtOutput.SelectionStart = $txtOutput.TextLength
				$txtOutput.ScrollToCaret()
			}, $Text)
	} else {
		$txtOutput.AppendText($Text + "`r`n")
		$txtOutput.SelectionStart = $txtOutput.TextLength
		$txtOutput.ScrollToCaret()
	}
}

<#
	.SYNOPSIS
		Get-ScriptDirectory returns the proper location of the script.
	
	.DESCRIPTION
		A detailed description of the Get-ScriptDirectory function.
	
	.OUTPUTS
		System.String
	
	.NOTES
		Returns the correct path within a packaged executable.
#>
function Get-ScriptDirectory {
	[OutputType([string])]
	param ()
	
	$retVal = ""
	if ($null -ne $hostinvocation) {
		$retVal = Split-Path $hostinvocation.MyCommand.path
	} else {
		$retVal = Split-Path $script:MyInvocation.MyCommand.Path
	}
	
	return $retVal
	
}

#region Find-Text block runner
# Every running find-text.ps1 process, keyed by its Process object.
# Value = per-block state (Tag, Index, IdCount, Eofs, Started).
$script:blockProcs = New-Object 'System.Collections.Generic.Dictionary[System.Diagnostics.Process,hashtable]'
$script:blockTotal = 0
$script:blockRunning = 0
$script:blockFailed = 0
$script:runStarted = $null
$script:findScript = ''

function Split-IdList {
	<#
		.SYNOPSIS
			Splits a comma-separated ID list into N evenly sized blocks.
		.NOTES
			Block sizes differ by at most one (10 IDs / 4 blocks = 3,3,2,2).
			BlockCount is clamped to the ID count so no block is ever empty.
	#>
	[OutputType([string[]])]
	param (
		[Parameter(Mandatory = $true)]
		[ValidateNotNullOrEmpty()]
		[string]$IdList,
		[Parameter(Mandatory = $true)]
		[ValidateRange(1, 2147483647)]
		[int]$BlockCount
	)
	
	$ids = @($IdList -split ',' | ForEach-Object {
			$_.Trim()
		} | Where-Object {
			$_
		})
	if ($ids.Count -eq 0) {
		return, [string[]]@()
	}
	if ($BlockCount -gt $ids.Count) {
		$BlockCount = $ids.Count
	}
	
	$baseSize = [int][math]::Floor($ids.Count / $BlockCount)
	$extra = $ids.Count % $BlockCount
	$blocks = New-Object 'System.Collections.Generic.List[string]'
	$start = 0
	for ($b = 0; $b -lt $BlockCount; $b++) {
		$size = $baseSize + [int]($b -lt $extra)
		$blocks.Add(($ids[$start .. ($start + $size - 1)] -join ','))
		$start += $size
	}
	return, $blocks.ToArray()
}

function Get-FindTextArguments {
	param (
		[Parameter(Mandatory = $true)]
		[string]$ScriptPath,
		[Parameter(Mandatory = $true)]
		[string]$IdList
	)
	
	$paramSwitch = if ($radLabSeries.Checked) {
		'-LabSeriesList'
	} else {
		'-LabProfileList'
	}
	
	# IMPORTANT: use -STA for interactive login flows (often required by embedded browsers/auth)
	$argList = @(
		'-NoProfile'
		'-ExecutionPolicy Bypass'
		'-STA'
		"-File `"$ScriptPath`""
		"$paramSwitch `"$IdList`""
		"-FindList `"$($txtFindText.Text.Trim())`""
		"-FindType `"$($cmbFindType.Text)`""
		"-CaseType `"$($cmbCaseType.Text)`""
	)
	if ($chkACPs.Checked) {
		$argList += '-checkACPs'
	}
	if ($chkLCAs.Checked) {
		$argList += '-checkLCAs'
	}
	if ($chkActivities.Checked) {
		$argList += '-checkActivities'
	}
	if ($chkInstructs.Checked) {
		$argList += '-checkInstructionsAndSwaps'
	}
	if ($chkDevComplete.Checked) {
		$argList += '-DevComplete'
	}
	
	return ($argList -join ' ')
}

function Get-BlockTag {
	# Returns the output prefix for the process that raised an event
	param ([System.Diagnostics.Process]$Process)
	
	if ($Process -and $script:blockProcs.ContainsKey($Process)) {
		return $script:blockProcs[$Process].Tag
	}
	return '[Block ?] '
}

function Complete-FindTextRun {
	# Runs once, after the last block has finished (or none could start)
	$elapsed = if ($script:runStarted) {
		(Get-Date) - $script:runStarted
	} else {
		[TimeSpan]::Zero
	}
	if ($script:blockTotal -gt 1) {
		$summary = "==== All {0} blocks finished in {1:hh\:mm\:ss}" -f $script:blockTotal, $elapsed
		if ($script:blockFailed -gt 0) {
			$summary += " ($($script:blockFailed) failed or returned a non-zero exit code)"
		}
		Add-UiText ($summary + " ====")
	}
	$script:proc = $null
	
#	$mergeScript = Join-Path $PSScriptRoot 'Report-FindText.ps1'
	$mergeScript = "$(Get-ScriptDirectory)\Report-FindText.ps1" 
	$result = & $mergeScript -OutputText $txtOutput.Text -OpenHtml `
							 -WarningVariable mergeWarnings -WarningAction SilentlyContinue
	
	ForEach ($w In $mergeWarnings) {
		$txtOutput.AppendText("WARNING: $w`r`n")
	}
	If ($result) {
		$txtOutput.AppendText("Combined CSV: $($result.CombinedCsv)`r`nHTML report:  $($result.HtmlReport)`r`n")
	}
	
	$btnFindText.Enabled = $true
}

function Complete-FindTextBlock {
	# Runs on the UI thread (via BeginInvoke) after both streams of one process hit EOF
	param ([System.Diagnostics.Process]$Process)
	
	if (-not $script:blockProcs.ContainsKey($Process)) {
		return
	}
	$info = $script:blockProcs[$Process]
	$null = $script:blockProcs.Remove($Process)
	
	$exitCode = 'n/a'
	try {
		$Process.WaitForExit()
		$exitCode = $Process.ExitCode
	} catch {
		# Leave exit code as n/a
	} finally {
		$Process.Dispose()
	}
	
	if ($exitCode -ne 0) {
		$script:blockFailed++
	}
	$elapsed = (Get-Date) - $info.Started
	Add-UiText ("{0}---- Script finished (ExitCode={1}, {2:hh\:mm\:ss}) ----" -f $info.Tag, $exitCode, $elapsed)
	
	$script:blockRunning--
	if ($script:blockRunning -le 0) {
		Complete-FindTextRun
	}
}

function Complete-FindTextStream {
	# Called once per redirected stream (stdout, stderr) of a process at EOF.
	# A block is only finished when BOTH streams are drained, so no trailing
	# output lines are lost or mislabelled.
	param ([System.Diagnostics.Process]$Process)
	
	if (-not $script:blockProcs.ContainsKey($Process)) {
		return
	}
	$info = $script:blockProcs[$Process]
	$info.Eofs++
	if ($info.Eofs -lt 2) {
		return
	}
	
	# Defer until the current callback returns. Calling WaitForExit() directly
	# inside a SynchronizingObject callback deadlocks the stream reader thread.
	$null = $frmMain.BeginInvoke([System.Action[System.Diagnostics.Process]]{
			param ($proc)
			Complete-FindTextBlock -Process $proc
		}, $Process)
}

function Start-FindTextBlock {
	# Launches one find-text.ps1 process for one block. Returns $true if it started.
	[OutputType([bool])]
	param (
		[Parameter(Mandatory = $true)]
		[string]$IdList,
		[Parameter(Mandatory = $true)]
		[int]$Index
	)
	
	$tag = if ($script:blockTotal -gt 1) {
		"[Block $Index/$($script:blockTotal)] "
	} else {
		''
	}
	$idCount = @($IdList -split ',' | Where-Object {
			$_.Trim()
		}).Count
	
	$argString = Get-FindTextArguments -ScriptPath $script:findScript -IdList $IdList
	Add-UiText "$($tag)Starting ($idCount IDs): powershell.exe $argString"
	
	$psi = New-Object System.Diagnostics.ProcessStartInfo
	$psi.FileName = "$env:WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe"
	$psi.Arguments = $argString
	$psi.UseShellExecute = $false
	$psi.RedirectStandardOutput = $true
	$psi.RedirectStandardError = $true
	$psi.CreateNoWindow = $true
	$psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
	$psi.StandardErrorEncoding = [System.Text.Encoding]::UTF8
	
	$p = New-Object System.Diagnostics.Process
	$p.StartInfo = $psi
	
	# Raise events on the UI thread (prevents cross-thread crashes)
	$p.SynchronizingObject = $frmMain
	
	# Register state BEFORE starting so the first output line can find its tag
	$script:blockProcs[$p] = @{
		Tag	    = $tag
		Index   = $Index
		IdCount = $idCount
		Eofs    = 0
		Started = Get-Date
	}
	
	# $sender is the Process that raised the event, which identifies the block
	$p.add_OutputDataReceived({
			param ($sender,
				$e)
			if ($null -eq $e.Data) {
				Complete-FindTextStream -Process $sender
			} elseif ($e.Data) {
				Add-UiText ((Get-BlockTag -Process $sender) + $e.Data)
			}
		})
	
	$p.add_ErrorDataReceived({
			param ($sender,
				$e)
			if ($null -eq $e.Data) {
				Complete-FindTextStream -Process $sender
			} elseif ($e.Data) {
				Add-UiText ((Get-BlockTag -Process $sender) + "ERROR: " + $e.Data)
			}
		})
	
	try {
		$null = $p.Start()
		$script:blockRunning++
		$p.BeginOutputReadLine()
		$p.BeginErrorReadLine()
		return $true
	} catch {
		$null = $script:blockProcs.Remove($p)
		$p.Dispose()
		$script:blockFailed++
		Add-UiText "$($tag)FAILED to start process: $($_.Exception.Message)"
		return $false
	}
}
#endregion

$frmMain_Load={
	# Set the current Directory
	$outPath = Get-ScriptDirectory
	# Replace path if using "Program Files"
	if ($outPath -like "C:\Program Files*") {
		# Replace the output folder with a writable folder
		$newPath = $outPath -Replace '^C:\\Program Files', 'C:\temp'
		#create the output folder
		New-Item -Path $newPath -ItemType Directory -Force | Out-Null
	} else {
		$newPath = $retVal
	}
	$script:dir = $newPath
#	$script:dir = Get-ScriptDirectory
	
	$cmbFindType.Text = "Contains"
	$cmbCaseType.Text = "Any"
}

$radLabSeries_CheckedChanged={
	if ($radLabProfiles.Checked) {
		$numBlockSize.Enabled = $true
	} else {
		$numBlockSize.Enabled = $false
	}
}

$radLabProfiles_CheckedChanged={
	if ($radLabProfiles.Checked) {
		$numBlockSize.Enabled = $true
	} else {
		$numBlockSize.Enabled = $false
	}
}

