$txtIDList_Leave = {
	# Split the Series/Profile list and count the elements
	$count = (
		$txtIDList.Text.ToString() -split ',' |
		Where-Object {
			$_.Trim().Length -gt 0
		}
	).Count
	
	$lblIDCount.Text = "($($count))"
}
