	# AI Attempt
	# Run "find-text.ps1" once per ID block, all blocks concurrently, and capture the output
	$txtOutput.Clear()
	
	# Validate the form
	$isValid = Validate-Form
	if (-not $isValid.State) {
		$txtOutput.Text = $isValid.Msg
		return
	}
	
	# Retrieve the path to this form and the PS script
	$script:findScript = "$(Get-ScriptDirectory)\find-text.ps1" # or pick with OpenFileDialog
	
	# Verify that the executable script exists
	if (-not (Test-Path -Path $script:findScript)) {
		$txtOutput.Text = "Could not find the powershell script: $($script:findScript)"
		return
	}
	
	# Blocking only applies to Lab Profiles; Lab Series always runs as one block
	$idList = $txtIDList.Text.Trim()
	$blockCount = 1
	if ($radLabProfiles.Checked) {
		$blockCount = [int]$numBlockSize.Value
	}
	
	if ($blockCount -gt 1) {
		$blocks = Split-IdList -IdList $idList -BlockCount $blockCount
	} else {
		$blocks = @($idList)
	}
	
	# Reset run state
	$script:blockProcs.Clear()
	$script:blockTotal = $blocks.Count
	$script:blockRunning = 0
	$script:blockFailed = 0
	$script:runStarted = Get-Date
	
	if ($script:blockTotal -gt 1) {
		$idCount = @($idList -split ',' | Where-Object {
				$_.Trim()
			}).Count
		Add-UiText "Split $idCount Lab Profile IDs into $($script:blockTotal) blocks (running concurrently)"
		if ($script:blockTotal -lt $blockCount) {
			Add-UiText "Note: $blockCount blocks requested but only $idCount IDs supplied; using $($script:blockTotal)."
		}
	}
	
	# Prevent re-entry while blocks are running
	$btnFindText.Enabled = $false
	
	# Launch every block now. Completion events queue on the UI thread and are
	# not processed until this handler returns, so the running count is accurate.
	for ($i = 0; $i -lt $blocks.Count; $i++) {
		$null = Start-FindTextBlock -IdList $blocks[$i] -Index ($i + 1)
	}
	
	# Nothing started (every launch failed): finish immediately
	if ($script:blockRunning -eq 0) {
		Complete-FindTextRun
	}
}

