$btnSaveOutput_Click={
	# DateTime stamp (filesystem-safe)
	$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
	
	# Dialog configuration
	$saveDialog.Title = "Save Change Org Log"
	$saveDialog.Filter = "Log Files (*.log)|*.log|All Files (*.*)|*.*"
	$saveDialog.DefaultExt = "log"
	$saveDialog.FileName = "FindText_$timestamp.log"
	$saveDialog.InitialDirectory = $script:dir
	$saveDialog.OverwritePrompt = $true
	
	# Show dialog
	if ($saveDialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
		
		$filePath = $saveDialog.FileName
		$directory = [System.IO.Path]::GetDirectoryName($filePath)
		# $script:dir
		# Auto-create folder if it does not exist
		if (-not [System.IO.Directory]::Exists($directory)) {
			[System.IO.Directory]::CreateDirectory($directory) | Out-Null
		}
		
		# Write TextBox contents to file
		[System.IO.File]::WriteAllText(
			$filePath,
			$txtOutput.Text,
			[System.Text.Encoding]::UTF8
		)
		
		[System.Windows.Forms.MessageBox]::Show(
			"File saved successfully:`n$filePath",
			"Save Complete",
			[System.Windows.Forms.MessageBoxButtons]::OK,
			[System.Windows.Forms.MessageBoxIcon]::Information
		)
	}
	
}

