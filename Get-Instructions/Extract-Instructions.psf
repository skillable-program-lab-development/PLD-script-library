$mskLabProfile_Leave={
	$inst = Invoke-WithRetry {
		Get-LODLabProfileInstructionsSets -LabProfileId $mskLabProfile.Text
	}
	$cmbInstSets.DataSource = $null
	$instSets.Clear()
	foreach ($item in $inst.instructionsSets) {
		$instSets.Add(
			[PSCustomObject]@{
				Id   = $item.Id
				Name = "$($item.Id): ($($item.DisplayId)) - $($item.languageShortName): $($item.Name)"
			}
		)
	}
	if ($instSets.count -gt 0) {
		$cmbInstSets.DataSource = $instSets
		$cmbInstSets.DisplayMember = 'Name'
		$cmbInstSets.ValueMember = 'Id'
	}
	
}

