$btnFolder_Click = {
	$dialog = New-Object System.Windows.Forms.SaveFileDialog
	$dialog.InitialDirectory = $txtFolder.Text
	$dialog.DefaultExt = "md"
	$dialog.FileName = "Select a Folder"
	$dialog.Filter = "Markdown Files (*.md)|*.md|Text Files (*.txt)|*.txt|All Files (*.*)|*.*"
	$dialog.OverwritePrompt = $false
	$dialog.CheckPathExists = $true
	$dialog.CheckFileExists = $false
	
	# Default filter selected when dialog opens
	$dialog.FilterIndex = 3 # 1=Markdown, 2=Text, 3=All
	
	if ($dialog.ShowDialog() -eq 'OK') {
##		$txtFolder.Text = $dialog.SelectedPath
#		$txtFolder.Text = Split-Path $dialog.FileName -Parent
		
		# Derive folder from selected file
		$selectedFolder = [System.IO.Path]::GetDirectoryName($dialog.FileName)
		
		# Populate textbox
		$txtFolder.Text = $selectedFolder
	}
	
}

