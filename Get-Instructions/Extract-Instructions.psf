  <Code><![CDATA[# Global Fields
$instSets = New-Object System.Collections.Generic.List[object]
$isShown = $false

function Write-Note {
	[CmdletBinding()]
	param
	(
		$note,
		[switch]$hideTimeStamp
	)
	
	$timeStamp = Get-Date -Format "MM/dd/yy_HH:mm:ss"
	
	if ($hideTimeStamp) {
		Write-Output "$($note)"
	} else {
		Write-Output "$($timeStamp):  $($note)"
	}
	
}

function Add-UiText {
	param ([string]$Text)
	
	if ([string]::IsNullOrEmpty($Text)) {
		return
	}
	
	if ([string]::IsNullOrWhiteSpace($Text)) {
		return
	}
	
	# Marshal to UI thread safely
	if ($txtSwapOutput.InvokeRequired) {
		$null = $txtSwapOutput.BeginInvoke([Action[string]]{
				param ($t)
				$txtSwapOutput.AppendText($t + "`r`n")
				$txtSwapOutput.SelectionStart = $txtSwapOutput.TextLength
				$txtSwapOutput.ScrollToCaret()
			}, $Text)
	} else {
		if ($Text.Length -gt 0) {
			$txtSwapOutput.AppendText($Text + "`r`n")
			$txtSwapOutput.SelectionStart = $txtSwapOutput.TextLength
			$txtSwapOutput.ScrollToCaret()
		}
	}
}

