<#
	.SYNOPSIS
		Get-ScriptDirectory returns the proper location of the script.
	
	.DESCRIPTION
		A detailed description of the Get-ScriptDirectory function.
	
	.OUTPUTS
		System.String
	
	.NOTES
		Returns the correct path within a packaged executable.
#>
function Get-ScriptDirectory {
	[OutputType([string])]
	param ()
	
	$retVal = ""
	if ($null -ne $hostinvocation) {
		$retVal = Split-Path $hostinvocation.MyCommand.path
	} else {
		$retVal = Split-Path $script:MyInvocation.MyCommand.Path
	}
	
	return $retVal
}

function ConvertTo-SafeArg {
	param ([string]$Value)
	'"' + ($Value -replace '"', '\"') + '"'
}

function Validate-Form {
	$retVal = @{
		State = $true
		Msg   = "Success"
	}
	
	# Validate Images ready
#	if ($lvwImages.Items.Count -eq 0) {
#		$retVal.State = $false
#		$retVal.Msg = "The Image folder must be selected and contain images"
#	}
	
	# Validate Instructions Set selected
	if ($cmbInstSets.Text.Length -eq 0) {
		$retVal.State = $false
		$retVal.Msg = "The Instructions Set must be selected"
	}
	
	# Validate Instructions Set List
	if ($cmbInstSets.Items.Count -eq 0) {
		$retVal.State = $false
		$retVal.Msg = "The Lab Profile ID and Instructions Set must be populated"
	}
	
	return $retVal
}

function Invoke-WithRetry {
	param
	(
		[scriptblock]$Command,
		[int]$Retries = 1
	)
	
	$attempt = 0
	while ($true) {
		try {
			& $Command
			return # success, exit function
		} catch {
			$attempt++
			if ($attempt -le $Retries) {
				Write-Note -note "    Command failed on lab $($curId). Retrying attempt $attempt of $Retries..."
				Write-Note -note "    Command: $($Command)"
				Write-Warning "Command failed on lab $($curId). Retrying attempt $attempt of $Retries..."
				Write-Warning "  Command: $($Command)"
				Start-Sleep -Seconds 1 # optional backoff
			} else {
				throw # re-raise the error after retries exhausted
			}
		}
	}
}

$frmMain_Load={
	# Set the current Directory
	$outPath = Get-ScriptDirectory
	# test is $outPath is a valid folder
	if (Test-Path -Path $outPath -PathType Container){
	# Replace path if using "Program Files"
		if ($outPath -like "C:\Program Files*") {
			# Replace the output folder with a writable folder
			$newPath = $outPath -Replace '^C:\\Program Files', 'C:\temp'
			#create the output folder
			New-Item -Path $newPath -ItemType Directory -Force | Out-Null
		} else {
			$newPath = $outPath
		}
	} else {
		$newPath = ""
	}
	$script:dir = $newPath
	$txtFolder.Text = $newPath
}

$txtSwapOutput_TextChanged={
	if ($txtSwapOutput.Text.Length -gt 0) {
		$btnSaveOutput.Enabled = $true
	} else {
		$btnSaveOutput.Enabled = $false
	}
}

$btnSaveOutput_Click={
	# DateTime stamp (filesystem-safe)
	$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
#	$timeStamp = Get-Date -Format "MM/dd/yy_HH:mm:ss"
	
	# Dialog configuration
	$saveDialog = New-Object System.Windows.Forms.SaveFileDialog
	$saveDialog.Title = "Save Extract-Instructions Log"
	$saveDialog.Filter = "Log Files (*.log)|*.log|All Files (*.*)|*.*"
	$saveDialog.DefaultExt = "log"
	$saveDialog.FileName = "Extract-Instructions_$timestamp.log"
	$saveDialog.InitialDirectory = $txtFolder.Text
	$saveDialog.OverwritePrompt = $true
	$saveDialog.CheckPathExists = $true
	$saveDialog.CheckFileExists = $false
	
	# Show dialog
	if ($saveDialog.ShowDialog() -eq 'OK') {
		
		$filePath = $saveDialog.FileName
		$directory = [System.IO.Path]::GetDirectoryName($filePath)
		# Auto-create folder if it does not exist
		if (-not [System.IO.Directory]::Exists($directory)) {
			[System.IO.Directory]::CreateDirectory($directory) | Out-Null
		}
		
		# Write TextBox contents to file
		[System.IO.File]::WriteAllText(
			$filePath,
			$txtSwapOutput.Text,
			[System.Text.Encoding]::UTF8
		)
		
		[System.Windows.Forms.MessageBox]::Show(
			"File saved successfully:`n$filePath",
			"Save Complete",
			[System.Windows.Forms.MessageBoxButtons]::OK,
			[System.Windows.Forms.MessageBoxIcon]::Information
		)
	}
}

