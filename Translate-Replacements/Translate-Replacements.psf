#region Control Helper Functions
function Update-ComboBox
{
<#
	.SYNOPSIS
		This functions helps you load items into a ComboBox.
	
	.DESCRIPTION
		Use this function to dynamically load items into the ComboBox control.
	
	.PARAMETER ComboBox
		The ComboBox control you want to add items to.
	
	.PARAMETER Items
		The object or objects you wish to load into the ComboBox's Items collection.
	
	.PARAMETER DisplayMember
		Indicates the property to display for the items in this control.
		
	.PARAMETER ValueMember
		Indicates the property to use for the value of the control.
	
	.PARAMETER Append
		Adds the item(s) to the ComboBox without clearing the Items collection.
	
	.EXAMPLE
		Update-ComboBox $combobox1 "Red", "White", "Blue"
	
	.EXAMPLE
		Update-ComboBox $combobox1 "Red" -Append
		Update-ComboBox $combobox1 "White" -Append
		Update-ComboBox $combobox1 "Blue" -Append
	
	.EXAMPLE
		Update-ComboBox $combobox1 (Get-Process) "ProcessName"
	
	.NOTES
		Additional information about the function.
#>
	
	param
	(
		[Parameter(Mandatory = $true)]
		[ValidateNotNull()]
		[System.Windows.Forms.ComboBox]
		$ComboBox,
		[Parameter(Mandatory = $true)]
		[ValidateNotNull()]
		$Items,
		[Parameter(Mandatory = $false)]
		[string]$DisplayMember,
		[Parameter(Mandatory = $false)]
		[string]$ValueMember,
		[switch]
		$Append
	)
	
	if (-not $Append)
	{
		$ComboBox.Items.Clear()
	}
	
	if ($Items -is [Object[]])
	{
		$ComboBox.Items.AddRange($Items)
	}
	elseif ($Items -is [System.Collections.IEnumerable])
	{
		$ComboBox.BeginUpdate()
		foreach ($obj in $Items)
		{
			$ComboBox.Items.Add($obj)
		}
		$ComboBox.EndUpdate()
	}
	else
	{
		$ComboBox.Items.Add($Items)
	}
	
	if ($DisplayMember)
	{
		$ComboBox.DisplayMember = $DisplayMember
	}
	
	if ($ValueMember)
	{
		$ComboBox.ValueMember = $ValueMember
	}
}

function Invoke-ReplacementsAsync {
	param (
		[System.Windows.Forms.TextBox]$TextBox,
		[string]$InstructionsFile,
		[string]$TranslationFile,
		[string]$ReplacementsFile,
		[string]$ClaudeModel,
		[string]$OutputPath
	)
	
	$buildScript = Join-Path $PSScriptRoot 'Apply-Replacements.ps1'
	
	$ps = [System.Management.Automation.PowerShell]::Create()
	[void]$ps.AddScript($buildScript)
	[void]$ps.AddParameter('InstructionsFile', $InstructionsFile)
	[void]$ps.AddParameter('TranslationFile', $TranslationFile)
	[void]$ps.AddParameter('ReplacementsFile', $ReplacementsFile)
	[void]$ps.AddParameter('ClaudeModel', $ClaudeModel)
	[void]$ps.AddParameter('ReportRepLine', $true)
	[void]$ps.AddParameter('OutputName', 'REP')
	[void]$ps.AddParameter('OutputPath', $OutputPath)
	
	# Marshal every stream back onto the UI thread as it arrives.
	$appendLine = {
		param ($line)
		if ($TextBox.InvokeRequired) {
			$TextBox.BeginInvoke([Action[string]]{
					param ($l) $TextBox.AppendText("$l`r`n")
				}, $line)
		} else {
			$TextBox.AppendText("$line`r`n")
		}
	}
	
	Register-ObjectEvent -InputObject $ps.Streams.Information -EventName DataAdded -Action {
		$line = $Event.MessageData.Streams.Information[$EventArgs.Index].MessageData
		& $Event.MessageData.AppendLine $line
	} -MessageData @{
		Streams = $ps.Streams; AppendLine = $appendLine
	} | Out-Null
	
	Register-ObjectEvent -InputObject $ps.Streams.Error -EventName DataAdded -Action {
		$line = $Event.MessageData.Streams.Error[$EventArgs.Index].ToString()
		& $Event.MessageData.AppendLine $line
	} -MessageData @{
		Streams = $ps.Streams; AppendLine = $appendLine
	} | Out-Null
	
	$asyncResult = $ps.BeginInvoke()
	
	# Poll for completion off the UI thread via a WinForms Timer (cheap, no extra runspace needed).
	$timer = New-Object System.Windows.Forms.Timer
	$timer.Interval = 250
	$timer.Add_Tick({
			if ($asyncResult.IsCompleted) {
				$timer.Stop()
				$results = $ps.EndInvoke($asyncResult)
				$results | ForEach-Object {
					& $appendLine $_.ToString()
				}
				$ps.Dispose()
			}
		})
	$timer.Start()
}
#endregion

$btnFolder_Click = {
	if (-not (Test-Path -Path $txtFolder.Text -PathType Container)) {
		New-Item -Path $txtFolder.Text -ItemType Directory -Force
	}
	
	$dialog = New-Object System.Windows.Forms.SaveFileDialog
	$dialog.InitialDirectory = $txtFolder.Text
	$dialog.DefaultExt = "md"
	$dialog.FileName = "Select a Folder"
	$dialog.Filter = "Markdown Files (*.md)|*.md|Text Files (*.txt)|*.txt|All Files (*.*)|*.*"
	$dialog.OverwritePrompt = $false
	$dialog.CheckPathExists = $true
	$dialog.CheckFileExists = $false
	
	# Default filter selected when dialog opens
	$dialog.FilterIndex = 3 # 1=Markdown, 2=Text, 3=All
	
	if ($dialog.ShowDialog() -eq 'OK') {
		
		# Derive folder from selected file
		$selectedFolder = [System.IO.Path]::GetDirectoryName($dialog.FileName)
		
		# Populate textbox
		$txtFolder.Text = $selectedFolder
	}
	
}

