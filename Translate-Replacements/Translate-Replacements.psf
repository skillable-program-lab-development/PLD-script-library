}

$mskLabProfileTrg_Leave = {
	try {
		$inst2 = Invoke-WithRetry {
			Get-LODLabProfileInstructionsSets -LabProfileId $mskLabProfileTrg.Text
		}
		$cmbInstSetsTrg.DataSource = $null
		$instSets2.Clear()
		foreach ($item in $inst2.instructionsSets) {
			$instSets2.Add(
				[PSCustomObject]@{
					Id   = $item.Id
					Name = "$($item.Id): ($($item.DisplayId)) - $($item.languageShortName): $($item.Name)"
				}
			)
		}
		if ($instSets2.count -gt 0) {
			$cmbInstSetsTrg.DataSource = $instSets2
			$cmbInstSetsTrg.DisplayMember = 'Name'
			$cmbInstSetsTrg.ValueMember = 'Id'
		}
	} catch {}
}

$mskLabProfileTrg_Click={
	$mskLabProfileTrg.Focus()
	$mskLabProfileTrg.Select(0, 0)
}

$mskLabProfileTrg_Enter={
	$mskLabProfileTrg.Focus()
	$mskLabProfileTrg.Select(0, 0)
}
