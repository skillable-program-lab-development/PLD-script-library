$chkResolveGitHub_CheckedChanged={
	#TODO: Place custom script here
	
}

$btnBeginTranslation_Click={
	# Clear the output text area
	$txtSwapOutput.Clear()
	
	# Validate the form
	$isValid = Validate-Form
	if (-not $isValid.State) {
		$txtSwapOutput.Text = $isValid.Msg
		return
	}
	
	# Retrieve the path to this form and the PS script
	$scriptPath = "$(Get-ScriptDirectory)\Translate-Replacements.ps1" 
	
	# Verify that the executable script exists
	if (-not (Test-Path -Path $scriptPath)) {
		$txtSwapOutput.Text = "Could not find the powershell script: $scriptPath"
		return
	}
	
	#	# Build the Argument list
	
	# IMPORTANT: use -STA for interactive login flows (often required by embedded browsers/auth)
	# Build the Argument list
	try {
		$token = Get-LODSessionToken
	} catch {
		$token = ""
	}
	$argParts = @(
		"-NoProfile"
		"-ExecutionPolicy Bypass"
		"-STA"
		"-File $(ConvertTo-SafeArg $scriptPath)"
		"-SourceLabProfileId $($mskLabProfileSrc.Text)"
		"-SourceInstructionsSetId $($cmbInstSetsSrc.SelectedValue.ToString())"
		"-TargetLabProfileId $($mskLabProfileTrg.Text)"
		"-TargetInstructionsSetId $($cmbInstSetsTrg.SelectedValue.ToString())"
		"-ClaudeModel $($cmbClaudeModel.Text)"
		"-OutputPath $(ConvertTo-SafeArg $txtFolder.Text)"
		"-sessionToken $(ConvertTo-SafeArg $token)"
	)

	if ($chkResolveGitHub.Checked) {
		$argParts += "-ExpandIncludes"
	}
	$args = $argParts -join ' '
	$lnch = $args.Replace($token, '[redacted]')
	
	
	Add-UiText "Starting: powershell.exe $lnch`r`n"
#	Add-UiText "Starting: powershell.exe Translate-Replacements`r`n"
	
	$psi = New-Object System.Diagnostics.ProcessStartInfo
	$psi.FileName = "$env:WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe"
	$psi.Arguments = $args
	$psi.UseShellExecute = $false
	$psi.RedirectStandardOutput = $true
	$psi.RedirectStandardError = $true
	$psi.CreateNoWindow = $true
	$psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
	$psi.StandardErrorEncoding = [System.Text.Encoding]::UTF8
	
	$p = New-Object System.Diagnostics.Process
	$p.StartInfo = $psi
	$p.EnableRaisingEvents = $true
	
	# Raise events on the UI thread (prevents cross-thread crashes)
	$p.SynchronizingObject = $frmMain
	
	$p.add_OutputDataReceived({
			param ($sender,
				$e)
			if ($e.Data) {
				Add-UiText $e.Data
			}
		}
	)
	
	$p.add_ErrorDataReceived({
			param ($sender,
				$e)
			if ($e.Data) {
				Add-UiText ("ERROR: " + $e.Data)
			}
		}
	)
	
	$p.add_Exited({
			param ($sender,
				$e)
			try {
				Add-UiText ("---- Script finished (ExitCode={0}) ----" -f $sender.ExitCode)
			} catch {
				Add-UiText "---- Script finished ----"
			}
		}
	)
	
	try {
		$null = $p.Start()
		try {
			$p.BeginOutputReadLine()
		} catch [System.InvalidOperationException] {
			# Process already exited before we could attach the reader - benign.
		}
#		$p.BeginOutputReadLine()
		try {
			$p.BeginErrorReadLine()
		} catch [System.InvalidOperationException] {
			# Same as above.
		}
#		$p.BeginErrorReadLine()
		$script:proc = $p
	} catch {
		Add-UiText "FAILED to start process: $($_.Exception.Message)"
	}
}

