	#TODO: Place custom script here
	
}

$mskLabProfileTrg_MaskInputRejected=[System.Windows.Forms.MaskInputRejectedEventHandler]{
#Event Argument: $_ = [System.Windows.Forms.MaskInputRejectedEventArgs]
