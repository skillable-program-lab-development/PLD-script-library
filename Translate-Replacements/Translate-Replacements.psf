$mskLabProfileSrc_Leave = {
	try {
		$inst1 = Invoke-WithRetry {
			Get-LODLabProfileInstructionsSets -LabProfileId $mskLabProfileSrc.Text
		}
		$cmbInstSetsSrc.DataSource = $null
		$instSets1.Clear()
		foreach ($item in $inst1.instructionsSets) {
			$instSets1.Add(
				[PSCustomObject]@{
					Id   = $item.Id
					Name = "$($item.Id): ($($item.DisplayId)) - $($item.languageShortName): $($item.Name)"
				}
			)
		}
		if ($instSets1.count -gt 0) {
			$cmbInstSetsSrc.DataSource = $instSets1
			$cmbInstSetsSrc.DisplayMember = 'Name'
			$cmbInstSetsSrc.ValueMember = 'Id'
		}
	} catch {}
}

