              <td width="20%">$($rmtFile["versions"]["processResourceScrape.ps1"])</td>
          </tr>
          <tr>
              <td width="60%">Rules File</td>
              <td width="20%">$($script:verFile["versions"]["rules.xml"])</td>
              <td width="20%">$($rmtFile["versions"]["rules.xml"])</td>
          </tr>
          <tr>
              <td width="60%">WKUtils Cloud Harbor</td>
              <td width="20%">$((Get-Version -software 'WKUtils Cloud Harbor').Version)</td>
              <td width="20%">$($rmtFile["versions"]["CloudHarbor.msi"])</td>
          </tr>
        </tbody>
      </table>
    </div>
"@
	
	# if github installer is newer than current version
	$showDownload = $false
	if ($lclVersionMSI -lt $rmtVersionMSI) {
		$versionMsg += @"
    <br>&nbsp;&nbsp;
    <strong><u>Cloud Harbor is Out-Of-Date</u></strong>
    <br><br>
    A new version of the Cloud Harbor installer is available.
  </body>
</html>
"@
		$showDownload = $true
	} else {
		#		$versionMsg += "`n`nUp-To-Date`nYou have installed the latest version of the WKUtils`nCloud Harbor package. An installer is not available`nfor any out-of-date components."
		$versionMsg += @"
    <br>&nbsp;&nbsp;
    <strong><u>Cloud Harbor is Up-To-Date</u></strong>
    <br><br>
    You have installed the latest version of the WKUtils Cloud Harbor package. An installer is not available`nfor any out-of-date components.
  </body>
</html>
"@
	}
	
	# Create the form
	$frmVersions = New-Object System.Windows.Forms.Form
	$frmVersions.Text = "Cloud Harbor Info"
	$frmVersions.Size = New-Object System.Drawing.Size(360, 300)
	$frmVersions.Icon = "Cloud_Harbor_transparent_64.ico"
	$frmVersions.StartPosition = "CenterScreen"
	
	# Create a label to display the version information
	$lblVersions = New-Object System.Windows.Forms.WebBrowser
	$lblVersions.Location = New-Object System.Drawing.Point(10, 20)
	$lblVersions.Size = New-Object System.Drawing.Size(320, 200)
	$lblVersions.ScrollBarsEnabled = $false
	$lblVersions.DocumentText = $versionMsg
	
	# Add the label to the form
	$frmVersions.Controls.Add($lblVersions)
	
	# Create a label to display the download link
	if ($showDownload) {
		# Redefine the form size
		$frmVersions.Size = New-Object System.Drawing.Size(360, 300)
		# Redefine the label size
		$lblVersions.Size = New-Object System.Drawing.Size(320, 170)
		
		# Define the email Link
		$emailLabel = New-Object System.Windows.Forms.LinkLabel
		$emailLabel.Text = "Request the latest WKUtils Cloud Harbor Installer"
		$emailLabel.AutoSize = $true
		$emailLabel.Location = New-Object System.Drawing.Point(40, 200)
		$emailLabel.Font = New-Object System.Drawing.Font("Microsoft Sans Serif", 8.25, [System.Drawing.FontStyle]::Underline)
		$emailLabel.ForeColor = [System.Drawing.Color]::Blue
		
		# Add event handler for the LinkClicked event
		$emailLabel.Add_Click({
				$msgBody = "I%20would%20like%20to%20request%20the%20latest%20WKUtils%20Cloud%20Harbor%20Installer"
				$emailAddress = "mailto:wayne.klapwyk@skillable.com?subject=WKUtils%20Cloud%20Harbor%20Installer%20Request&body=$($msgBody)"
				Start-Process $emailAddress
			})
		
		# Define the Download Link
		$linkLabel = New-Object System.Windows.Forms.LinkLabel
		$linkLabel.Text = "Download the Cloud Harbor Installer"
		$linkLabel.AutoSize = $true
		$linkLabel.Location = New-Object System.Drawing.Point(70, 220)
		$linkLabel.Links.Add(0, $linkLabel.Text.Length, "https://github.com/Yorik1971/process-rescrape/raw/main/Cloud%20Harbor.msi")
		$linkLabel.SendToBack()
		
		# Add event handler for the LinkClicked event
		$linkLabel.add_LinkClicked({
				$url = "https://github.com/Yorik1971/process-rescrape/raw/main/Cloud%20Harbor.msi"
				$dwn = (New-Object -ComObject Shell.Application).NameSpace('shell:Downloads').Self.Path
				$out = Join-Path -Path $dwn -ChildPath "WKUtils Cloud Harbor.msi"
				
				try {
					Invoke-WebRequest -Uri $url -OutFile $out
					Invoke-Item $dwn
				} catch {
					$errorMessage = $_.Exception.Message
					[System.Windows.Forms.MessageBox]::Show($frmVersions, "Error downloading the WKUtils Cloud Harbor installer:`r`n`r`n$errorMessage", "Download Error", "OK", [System.Windows.Forms.MessageBoxIcon]::Error)
				}
			}
		)
		
		$frmVersions.Controls.Add($emailLabel)
		$frmVersions.Controls.Add($linkLabel)
	}
	
	# Show the form as a modal dialog
	$frmVersions.ShowDialog()
	
	# To exit the script after the form is closed, you can use:
	# exit
}

$btnCompress_Click = {
	# Find the latest "resourceScrape_*.json" file
	$curScrape = Get-ChildItem -Path $txtPath.Text -Filter "resourceScrape_*.json" | Sort-Object LastWriteTime -Descending | Select-Object -First 1
	
	if ($curScrape) {
		# Get the filename without the extension
		$noExt = [System.IO.Path]::GetFileNameWithoutExtension($curScrape.Name)
		
		# Create the new filename with ".zip" extension
		$zipFile = "$($noExt).zip"
		
		try {
			Compress-Archive -Path $txtPath.Text -DestinationPath "$($txtPath.Text)\$($zipFile)" -Force
			
			Start-Process explorer.exe $txtPath.Text
		} catch {
			$errorMessage = $_.Exception.Message
			[System.Windows.Forms.MessageBox]::Show($frmMain, "Error compressing the WKUtils Cloud Harbor Resource Scrape:`r`n`r`n$errorMessage", "Compression Error", "OK", [System.Windows.Forms.MessageBoxIcon]::Error)
		}
	} else {
		[System.Windows.Forms.MessageBox]::Show($frmMain, "Could not find a 'resourceScrape_*.json' file in the output folder. No compression completed.`r`n`r`nPath: $($txtPath.Text)", "Compression Error", "OK", [System.Windows.Forms.MessageBoxIcon]::Error)
	}
}

