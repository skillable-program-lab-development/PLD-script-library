	if ($dlgFolder.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) {
		return
	}
	
	# Derive folder from selected file
	$selectedFolder = [System.IO.Path]::GetDirectoryName($dlgFolder.FileName)
	
	# Populate textbox
	$txtFolder.Text = $selectedFolder
	
	# Clear ListView items (NOT columns)
	$lvwImages.Items.Clear()
	
	# Allowed image extensions
	$imageExtensions = @('.jpg', '.jpeg', '.png', '.gif', '.bmp', '.tif', '.tiff')
	
	$files = Get-ChildItem -Path $selectedFolder -File |
	Where-Object {
		$imageExtensions -contains $_.Extension.ToLower()
	} |
	Sort-Object Name
	
	foreach ($file in $files) {
		
		$item = New-Object System.Windows.Forms.ListViewItem($file.Name)
		
		$sizeKB = [Math]::Round($file.Length / 1KB, 2)
		$item.SubItems.Add($sizeKB.ToString()) | Out-Null
		
		$lvwImages.Items.Add($item) | Out-Null
	}
	
#	$lblImages.Text = "est: $(($files.count)) images"
	$lblImages.Text = "$(($lvwImages.Items.Count)) images"
}

