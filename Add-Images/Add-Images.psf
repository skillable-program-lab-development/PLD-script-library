$buttonAddTheImagesToTheIns_Click={
	# Run the "Add-Images.ps1" script and capture the output
	$txtSwapOutput.Clear()
	
	# Validate the form
	$isValid = Validate-Form
	if (-not $isValid.State) {
		$txtSwapOutput.Text = $isValid.Msg
		return
	}
	
	# Retrieve the path to this form and the PS script
	$scriptPath = "$(Get-ScriptDirectory)\add-images.ps1" # or pick with OpenFileDialog
	
	# Verify that the executable script exists
	if (-not (Test-Path -Path $scriptPath)) {
		$txtSwapOutput.Text = "Could not find the powershell script: $scriptPath"
		return
	}
	
#	# Build the Argument list
#	$args = "-LabProfile $($mskLabProfile.Text) -InstSetId $($cmbInstSets.SelectedValue.ToString()) -ImageFolder $($txtFolder.Text)"
#	
#	# Execute the change-Organization.ps1 script
#	$psi = New-Object System.Diagnostics.ProcessStartInfo
#	$psi.FileName = "$env:WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe"
#	$psi.Arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$scriptPath`" $($args)"
#	$psi.UseShellExecute = $false
#	$psi.RedirectStandardOutput = $true
#	$psi.RedirectStandardError = $true
#	$psi.CreateNoWindow = $true
#	
#	$p = New-Object System.Diagnostics.Process
#	$p.StartInfo = $psi
#	$p.EnableRaisingEvents = $true
#	
#	# Capture StdOut to the output text field
#	$p.add_OutputDataReceived({
#			if ($_.Data) {
#				Add-UiText $_.Data
#			}
#		})
#	
#	# Capture StdErr to the output text field
#	$p.add_ErrorDataReceived({
#			if ($_.Data) {
#				Add-UiText ("ERROR: " + $_.Data)
#			}
#		})
#	
#	# Exit handler
#	$p.add_Exited({
#			Add-UiText "---- Script finished (ExitCode=$($p.ExitCode)) ----"
#		})
#	
#	$null = $p.Start()
#	$p.BeginOutputReadLine()
#	$p.BeginErrorReadLine()
#	
#	$script:proc = $p
	
	# IMPORTANT: use -STA for interactive login flows (often required by embedded browsers/auth)
	$args = "-NoProfile -ExecutionPolicy Bypass -STA -File `"$scriptPath`" "
	# Build the Argument list
	$args += "-LabProfile $($mskLabProfile.Text) -InstSetId $($cmbInstSets.SelectedValue.ToString()) -ImageFolder $($txtFolder.Text)"
	
	Add-UiText "Starting: powershell.exe $args"
	
	$psi = New-Object System.Diagnostics.ProcessStartInfo
	$psi.FileName = "$env:WINDIR\System32\WindowsPowerShell\v1.0\powershell.exe"
	$psi.Arguments = $args
	$psi.UseShellExecute = $false
	$psi.RedirectStandardOutput = $true
	$psi.RedirectStandardError = $true
	$psi.CreateNoWindow = $true
	$psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
	$psi.StandardErrorEncoding = [System.Text.Encoding]::UTF8
	
	$p = New-Object System.Diagnostics.Process
	$p.StartInfo = $psi
	$p.EnableRaisingEvents = $true
	
	# Raise events on the UI thread (prevents cross-thread crashes)
	$p.SynchronizingObject = $frmMain
	
	$p.add_OutputDataReceived({
			param ($sender,
				$e)
			if ($e.Data) {
				Add-UiText $e.Data
			}
		})
	
	$p.add_ErrorDataReceived({
			param ($sender,
				$e)
			if ($e.Data) {
				Add-UiText ("ERROR: " + $e.Data)
			}
		})
	
	$p.add_Exited({
			param ($sender,
				$e)
			try {
				Add-UiText ("---- Script finished (ExitCode={0}) ----" -f $sender.ExitCode)
			} catch {
				Add-UiText "---- Script finished ----"
			}
		})
	
	try {
		$null = $p.Start()
		$p.BeginOutputReadLine()
		$p.BeginErrorReadLine()
		$script:proc = $p
	} catch {
		Add-UiText "FAILED to start process: $($_.Exception.Message)"
	}
}

