$btnFolder_Click={
	#TODO: Place custom script here
#	if ($dlgFolder.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) {
#		return
#	}
#	
#	$selectedFolder = $dlgFolder.SelectedPath
