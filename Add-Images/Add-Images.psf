  <Code><![CDATA[# Global Fields
$instSets = New-Object System.Collections.Generic.List[object]

function Add-UiText {
	param ([string]$Text)
	
	if ([string]::IsNullOrEmpty($Text)) {
		return
	}
	
	if ([string]::IsNullOrWhiteSpace($Text)) {
		return
	}
	
	# Marshal to UI thread safely
	if ($txtSwapOutput.InvokeRequired) {
		$null = $txtSwapOutput.BeginInvoke([Action[string]]{
				param ($t)
				$txtSwapOutput.AppendText($t + "`r`n")
				$txtSwapOutput.SelectionStart = $txtSwapOutput.TextLength
				$txtSwapOutput.ScrollToCaret()
			}, $Text)
	} else {
		if ($Text.Length -gt 0) {
			$txtSwapOutput.AppendText($Text + "`r`n")
			$txtSwapOutput.SelectionStart = $txtSwapOutput.TextLength
			$txtSwapOutput.ScrollToCaret()
		}
	}
}

<#
	.SYNOPSIS
		Get-ScriptDirectory returns the proper location of the script.
	
	.DESCRIPTION
		A detailed description of the Get-ScriptDirectory function.
	
	.OUTPUTS
		System.String
	
	.NOTES
		Returns the correct path within a packaged executable.
#>
function Get-ScriptDirectory {
	[OutputType([string])]
	param ()
	
	$retVal = ""
	if ($null -ne $hostinvocation) {
		$retVal = Split-Path $hostinvocation.MyCommand.path
	} else {
		$retVal = Split-Path $script:MyInvocation.MyCommand.Path
	}
	
	return $retVal
}

function Validate-Form {
	$retVal = @{
		State = $true
		Msg   = "Success"
	}
	
	# Validate Images ready
	if ($lvwImages.Items.Count -eq 0) {
		$retVal.State = $false
		$retVal.Msg = "The Image folder must be selected and contain images"
	}
	
	# Validate Instructions Set selected
	if ($cmbInstSets.Text.Length -eq 0) {
		$retVal.State = $false
		$retVal.Msg = "The Instructions Set must be selected"
	}
	
	# Validate Instructions Set List
	if ($cmbInstSets.Items.Count -eq 0) {
		$retVal.State = $false
		$retVal.Msg = "The Lab Profile ID and Instructions Set must be populated"
	}
	
	return $retVal
}

function Invoke-WithRetry {
	param
	(
		[scriptblock]$Command,
		[int]$Retries = 1
	)
	
	$attempt = 0
	while ($true) {
		try {
			& $Command
			return # success, exit function
		} catch {
			$attempt++
			if ($attempt -le $Retries) {
				Write-Note -note "    Command failed on lab $($curId). Retrying attempt $attempt of $Retries..."
				Write-Note -note "    Command: $($Command)"
				Write-Warning "Command failed on lab $($curId). Retrying attempt $attempt of $Retries..."
				Write-Warning "  Command: $($Command)"
				Start-Sleep -Seconds 1 # optional backoff
			} else {
				throw # re-raise the error after retries exhausted
			}
		}
	}
}

$frmMain_Load={
	# Set the current Directory
	$outPath = Get-ScriptDirectory
	# Replace path if using "Program Files"
	if ($outPath -like "C:\Program Files*") {
		# Replace the output folder with a writable folder
		$newPath = $outPath -Replace '^C:\\Program Files', 'C:\temp'
		#create the output folder
		New-Item -Path $newPath -ItemType Directory -Force | Out-Null
	} else {
		$newPath = $retVal
	}
	$script:dir = $newPath
}

$numericupdown1_ValueChanged={
	#TODO: Place custom script here
	
}

$mskLabProfile_MaskInputRejected=[System.Windows.Forms.MaskInputRejectedEventHandler]{
#Event Argument: $_ = [System.Windows.Forms.MaskInputRejectedEventArgs]
	#TODO: Place custom script here
	
}

$mskLabProfile_Leave={
	#TODO: Place custom script here
	if ($btnConnect.Text -eq "Disconnect from Skillable Studio") {
		$inst = Invoke-WithRetry {
			Get-LODLabProfileInstructionsSets -LabProfileId $mskLabProfile.Text
		}
		$cmbInstSets.DataSource = $null
		$instSets.Clear()
		foreach ($item in $inst.instructionsSets) {
			$instSets.Add(
				[PSCustomObject]@{
				Id	    = $item.Id
				Name    = "($($item.DisplayId)) - $($item.languageShortName): $($item.Name)"
				}
			)
		}
		if ($instSets.count -gt 0) {
			$cmbInstSets.DataSource = $instSets
			$cmbInstSets.DisplayMember = 'Name'
			$cmbInstSets.ValueMember = 'Id'
		}
		
	}
}

$mskLabProfile_MouseLeave={
	#TODO: Place custom script here
	
}

$btnConnect_Click={
	#TODO: Place custom script here
	# Log in to Skillable Studio
	try {
		if ($btnConnect.Text -eq "Connect to Skillable Studio") {
			# Connect to Skillable Studio
			$conn = $false
			if (-not $global:LODSessionToken) {
				if (Test-Path -Path (Join-Path -Path $script:dir -ChildPath "LODCore.ses")) {
					$global:LODSessionToken = Get-Content -Path (Join-Path -Path $script:dir -ChildPath "LODCore.ses")
					try {
						Connect-LabOnDemand -ErrorAction Continue -SessionToken $global:LODSessionToken
						$conn = $true
					} catch {
						try {
							Connect-LabOnDemand -ERRORAction Continue
							Set-Variable -Name 'LODSessionToken' -Value $(Get-LODSessionToken) -Force -Option AllScope -Scope Global
						} catch {
							Set-Variable -Name LODSession -Value $null -Force
						}
					}
				} else {
					try {
						Connect-LabOnDemand -ERRORAction Continue
						Set-Variable -Name 'LODSessionToken' -Value $(Get-LODSessionToken) -Force -Option AllScope -Scope Global
					} else {
						Set-Variable -Name LODSession -Value $null -Force
					}
				}
			} else {
				try {
					Connect-LabOnDemand -ErrorAction Continue -SessionToken $global:LODSessionToken
				} catch {
					Set-Variable -Name LODSession -Value $null -Force
				}
			}
			if ($conn) {
				# Set the Connection Indicators
				$btnConnect.Text = "Disconnect from Skillable Studio"
				$lblConnStatus.ForeColor = 'LimeGreen'
				$lblConnStatus.Text = "Connected to Skillable studio"
				$stsBar.ForeColor = 'LimeGreen'
				$stsBar.Text = "Connected to Skillable Studio"
				$btnSearch.Enabled = $true
				$btnSearch.BackColor = 'LimeGreen'
			} else {
				
			}
		} else {
			# Disconnect from Skillable Studio
			Set-Variable -Name LODSession -Value $null -Force
			
			# Set the Connection Indicators
			$btnConnect.Text = "Connect to Skillable Studio"
			$lblConnStatus.ForeColor = 'IndianRed'
			$lblConnStatus.Text = "Disconnected from Skillable Studio"
			$stsBar.ForeColor = 'IndianRed'
			$stsBar.Text = "Disconnected - Please reconnect to continue"
			$btnSearch.Enabled = $false
			$btnSearch.BackColor = 'Pink'
		}
	} catch {
		$stsBar.ForeColor = 'IndianRed'
		$stsBar.Text = "FAILED TO CONNECT. Details: $($_.Exception.Message)"
	}
}

